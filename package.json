{
  "name": "goobrrr",
  "version": "0.1.0",
  "description": "A less than 1KB css-in-js solution",
  "keywords": [
    "css-in-js",
    "goober",
    "styled",
    "javascript",
    "react",
    "preact"
  ],
  "author": "Cristian <botecristian@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristianbote/goober"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./global": {
      "import": "./dist/global/index.js",
      "types": "./dist/global/index.d.ts"
    },
    "./should-forward-prop": {
      "import": "./dist/should-forward-prop/index.js",
      "types": "./dist/should-forward-prop/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm run dev:lib & pnpm run dev:demo",
    "dev:lib": "pnpm run build --watch",
    "dev:demo": "cd demo && pnpm run dev",
    "format": "oxfmt --write",
    "prepare": "husky"
  },
  "peerDependencies": {
    "csstype": "^3.0.10"
  },
  "devDependencies": {
    "@pretty-cozy/oxlint-config": "0.1.0",
    "csstype": "3.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxfmt": "0.67.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,html,md,json,yaml}": [
      "oxfmt --write"
    ]
  }
}

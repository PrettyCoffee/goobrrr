{
  "name": "goober",
  "version": "2.1.19",
  "description": "A less than 1KB css-in-js solution",
  "keywords": [
    "css-in-js",
    "goober",
    "styled",
    "javascript",
    "react",
    "preact"
  ],
  "author": "Cristian <botecristian@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristianbote/goober"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./global": {
      "import": "./dist/global/index.js",
      "types": "./dist/global/index.d.ts"
    },
    "./should-forward-prop": {
      "import": "./dist/should-forward-prop/index.js",
      "types": "./dist/should-forward-prop/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "prettier \"**/*.{js,ts,tsx,md}\" --write"
  },
  "peerDependencies": {
    "csstype": "^3.0.10"
  },
  "devDependencies": {
    "csstype": "^3.0.10",
    "husky": "4.2.4",
    "lint-staged": "10.2.0",
    "prettier": "2.0.5",
    "tsdown": "0.23.0",
    "typescript": "^3.6.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
